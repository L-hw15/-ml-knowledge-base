    "facts_concepts": [
      {"id": "ml:concept_cross_entropy", "name": "交叉熵损失", "definition": "用于分类任务的损失函数，衡量预测分布与真实分布的差异", "domain": "机器学习", "source": "sklearn_user_guide_v1.9.1", "confidence": 0.9, "validity": ["2026-01-01", null], "anchor": {"file_id": "sklearn_user_guide_v1.9.1", "position": "§1.2", "hash": "xxxxx"}},
      {"id": "ml:concept_regularization", "name": "正则化", "definition": "防止过拟合的技术，通过在损失函数中加入惩罚项限制模型复杂度", "domain": "机器学习", "source": "sklearn_user_guide_v1.9.1", "confidence": 0.9, "validity": ["2026-01-01", null], "anchor": {"file_id": "sklearn_user_guide_v1.9.1", "position": "§1.1.2", "hash": "xxxxx"}},
      {"id": "ml:concept_overfitting", "name": "过拟合", "definition": "模型在训练数据上表现良好但在新数据上泛化能力差的现象", "domain": "机器学习", "source": "sklearn_user_guide_v1.9.1", "confidence": 0.9, "validity": ["2026-01-01", null], "anchor": {"file_id": "sklearn_user_guide_v1.9.1", "position": "§12", "hash": "xxxxx"}},
      {"id": "ml:concept_underfitting", "name": "欠拟合", "definition": "模型在训练数据和新数据上都表现不佳的现象", "domain": "机器学习", "source": "sklearn_user_guide_v1.9.1", "confidence": 0.9, "validity": ["2026-01-01", null], "anchor": {"file_id": "sklearn_user_guide_v1.9.1", "position": "§12", "hash": "xxxxx"}},
      {"id": "ml:concept_data_leakage", "name": "数据泄露", "definition": "训练数据中包含测试集信息导致评估结果过于乐观的现象", "domain": "机器学习", "source": "sklearn_user_guide_v1.9.1", "confidence": 0.95, "validity": ["2026-01-01", null], "anchor": {"file_id": "sklearn_user_guide_v1.9.1", "position": "§12.2", "hash": "xxxxx"}},
      {"id": "ml:concept_convolution", "name": "卷积操作", "definition": "通过卷积核在输入特征图上滑动进行特征提取的操作，每个位置执行元素级乘法后求和", "domain": "深度学习", "source": "d2l.ai Ch7.1", "confidence": 0.95, "validity": ["2026-01-01", null], "anchor": {"file_id": "d2l.ai", "position": "Ch7.1", "hash": "xxxxx"}},
      {"id": "ml:concept_pooling", "name": "池化操作", "definition": "对特征图进行下采样操作，包括最大池化(取窗口内最大值)和平均池化(取窗口内平均值)，减少空间尺寸和计算量", "domain": "深度学习", "source": "d2l.ai Ch7.5", "confidence": 0.95, "validity": ["2026-01-01", null], "anchor": {"file_id": "d2l.ai", "position": "Ch7.5", "hash": "xxxxx"}},
      {"id": "ml:concept_batch_norm", "name": "批标准化", "definition": "在每个mini-batch上对输入进行标准化：BN(x)=γ⊙(x-μ_B)/σ_B+β，训练时用batch统计量，推理时用移动平均", "domain": "深度学习", "source": "d2l.ai Ch8.5", "confidence": 0.95, "validity": ["2026-01-01", null], "anchor": {"file_id": "d2l.ai", "position": "Ch8.5", "hash": "xxxxx"}},
      {"id": "ml:concept_dropout", "name": "Dropout正则化", "definition": "训练时随机将部分神经元输出置零(概率p)，推理时使用全部神经元并缩放，有效防止过拟合", "domain": "深度学习", "source": "d2l.ai Ch8.1", "confidence": 0.95, "validity": ["2026-01-01", null], "anchor": {"file_id": "d2l.ai", "position": "Ch8.1", "hash": "xxxxx"}},
      {"id": "ml:concept_residual_connection", "name": "残差连接", "definition": "将输入直接添加到卷积层输出：Y=F(X)+X，使网络学习残差F(X)=Y-X而非直接映射，便于梯度回传", "domain": "深度学习", "source": "d2l.ai Ch8.6", "confidence": 0.95, "validity": ["2026-01-01", null], "anchor": {"file_id": "d2l.ai", "position": "Ch8.6", "hash": "xxxxx"}},
      {"id": "ml:concept_attention_mechanism", "name": "注意力机制", "definition": "通过查询-键-值机制计算token间的依赖关系：Attention(Q,K,V)=softmax(QK^T/√d)V，允许模型动态关注重要信息", "domain": "深度学习", "source": "d2l.ai Ch11.3", "confidence": 0.95, "validity": ["2026-01-01", null], "anchor": {"file_id": "d2l.ai", "position": "Ch11.3", "hash": "xxxxx"}},
      {"id": "ml:concept_multi_head_attention", "name": "多头注意力", "definition": "多个注意力头并行计算：h_i=f(W_i^q q,W_i^k k,W_i^v v)，输出=W_o[h_1;...;h_h]，从不同子空间捕捉依赖关系", "domain": "深度学习", "source": "d2l.ai Ch11.5", "confidence": 0.95, "validity": ["2026-01-01", null], "anchor": {"file_id": "d2l.ai", "position": "Ch11.5", "hash": "xxxxx"}},
      {"id": "ml:concept_positional_encoding", "name": "位置编码", "definition": "通过三角函数为序列注入位置信息：p_{i,2j}=sin(i/10000^{2j/d})，p_{i,2j+1}=cos(i/10000^{2j/d})，弥补自注意力无法感知位置的缺陷", "domain": "深度学习", "source": "d2l.ai Ch11.6", "confidence": 0.95, "validity": ["2026-01-01", null], "anchor": {"file_id": "d2l.ai", "position": "Ch11.6", "hash": "xxxxx"}},
      {"id": "ml:concept_lstm_gate", "name": "LSTM门控机制", "definition": "长短期记忆网络通过三个门控(输入门、遗忘门、输出门)控制信息流动：I_t=σ(X_tW_xi+H_{t-1}W_hi)，F_t=σ(...)，O_t=σ(...)，解决RNN梯度消失问题", "domain": "深度学习", "source": "d2l.ai Ch10.1", "confidence": 0.95, "validity": ["2026-01-01", null], "anchor": {"file_id": "d2l.ai", "position": "Ch10.1", "hash": "xxxxx"}},
      {"id": "ml:concept_gru_gate", "name": "GRU门控机制", "definition": "门控循环单元简化版LSTM，两个门(重置门、更新门)：R_t=σ(X_tW_xr+H_{t-1}W_hr)，Z_t=σ(...)，比LSTM参数量少但性能相当", "domain": "深度学习", "source": "d2l.ai Ch10.2", "confidence": 0.95, "validity": ["2026-01-01", null], "anchor": {"file_id": "d2l.ai", "position": "Ch10.2", "hash": "xxxxx"}},
      {"id": "ml:concept_layer_norm", "name": "层标准化", "definition": "在特征维度上对输入进行标准化：LN(x)=γ⊙(x-μ)/σ+β，与BatchNorm不同，不依赖batch统计量，适用于RNN和Transformer", "domain": "深度学习", "source": "d2l.ai Ch11.7", "confidence": 0.95, "validity": ["2026-01-01", null], "anchor": {"file_id": "d2l.ai", "position": "Ch11.7", "hash": "xxxxx"}},
      {"id": "ml:concept_optimizer_adam", "name": "Adam优化器", "definition": "自适应矩估计：v_t=β1*v_{t-1}+(1-β1)g_t，s_t=β2*s_{t-1}+(1-β2)g_t^2，偏差校正后参数更新，结合动量和二阶矩自适应学习率", "domain": "深度学习", "source": "d2l.ai Ch12.10", "confidence": 0.95, "validity": ["2026-01-01", null], "anchor": {"file_id": "d2l.ai", "position": "Ch12.10", "hash": "xxxxx"}},
      {"id": "ml:concept_optimizer_momentum", "name": "Momentum优化器", "definition": "动量优化：v_t=β*v_{t-1}+g_{t,t-1}，x_t=x_{t-1}-η_t*v_t，累积历史梯度加速收敛", "domain": "深度学习", "source": "d2l.ai Ch12.6", "confidence": 0.95, "validity": ["2026-01-01", null], "anchor": {"file_id": "d2l.ai", "position": "Ch12.6", "hash": "xxxxx"}},
      {"id": "ml:concept_gradient_descent", "name": "梯度下降", "definition": "沿损失函数梯度反方向更新参数：x_t=x_{t-1}-η∇L(x)，是深度学习优化的基础算法", "domain": "深度学习", "source": "d2l.ai Ch12.3", "confidence": 0.95, "validity": ["2026-01-01", null], "anchor": {"file_id": "d2l.ai", "position": "Ch12.3", "hash": "xxxxx"}},
      {"id": "ml:concept_sequence_modeling", "name": "序列建模", "definition": "处理可变长度序列数据的建模方法，通过隐藏状态捕获时序依赖关系，是RNN/LSTM/Transformer的核心任务", "domain": "深度学习", "source": "d2l.ai Ch9.1", "confidence": 0.95, "validity": ["2026-01-01", null], "anchor": {"file_id": "d2l.ai", "position": "Ch9.1", "hash": "xxxxx"}}
